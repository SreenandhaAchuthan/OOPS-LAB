class Vehicle {
    String brand;
    int year;

    Vehicle(String brand, int year) {
        this.brand = brand;
        this.year = year;
        System.out.println("Vehicle Constructor: " + brand + " (" + year + ")");
    }

    void displayDetails() {
        System.out.println("Brand: " + brand + ", Year: " + year);
    }
}

class Car extends Vehicle {
    String fuelType;

    Car(String brand, int year, String fuelType) {
        super(brand, year);
        this.fuelType = fuelType;
        System.out.println("Car Constructor: Fuel Type - " + fuelType);
    }

    @Override
    void displayDetails() {
        super.displayDetails();
        System.out.println("Fuel Type: " + fuelType);
    }
}

class Truck extends Vehicle {
    int loadCapacity; 

    Truck(String brand, int year, int loadCapacity) {
        super(brand, year);
        this.loadCapacity = loadCapacity;
        System.out.println("Truck Constructor: Load Capacity - " + loadCapacity + " Tons");
    }

    @Override
    void displayDetails() {
        super.displayDetails();
        System.out.println("Load Capacity: " + loadCapacity + " Tons");
    }
}

class ElectricCar extends Car {
    int batteryCapacity; 

    ElectricCar(String brand, int year, int batteryCapacity) {
        super(brand, year, "Electric"); 
        this.batteryCapacity = batteryCapacity;
        System.out.println("ElectricCar Constructor: Battery Capacity - " + batteryCapacity + " kWh");
    }

    @Override
    void displayDetails() {
        super.displayDetails();
        System.out.println("Battery Capacity: " + batteryCapacity + " kWh");
    }
}

public class main {
    public static void main(String[] args) {
        System.out.println("---- Creating Objects ----\n");

        Vehicle[] fleet = new Vehicle[]{
            new Car("Toyota", 2022, "Petrol"),
            new Truck("Volvo", 2019, 15),
            new ElectricCar("Tesla", 2023, 100)
        };

        System.out.println("\n---- Displaying Vehicle Details ----\n");
        for (Vehicle v : fleet) {
            v.displayDetails();
            System.out.println("---------------------------");
        }
    }
}
