class Animal {
    void makeSound() {
        System.out.println("Animal makes a sound.");
    }
}
class Dog extends Animal {
    @Override
    void makeSound() {
        System.out.println("Dog barks: Woof Woof!");
    }
}
public class main{
    public static void main(String[] args) {
        Animal myAnimal = new Animal();
        myAnimal.makeSound();  
        
        Animal myDog = new Dog();
        myDog.makeSound();  
    }
}
