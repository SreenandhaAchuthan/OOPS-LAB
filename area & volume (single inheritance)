class room{
    double length;
    double breadth;
    room(double length,double breadth){
        this.length=length;
        this.breadth=breadth;
    }
    double area(){
        return length*breadth;
    }
}
class volume extends room{
    double height;
    volume(double length,double breadth,double height){
        super(length,breadth);
        this.height=height;
    }
    double volume(){
        return length*breadth*height;
    }
}
public class main{
    public static void main(String[] args){
        double length=10;
        double height=10;
        double breadth=10;
        volume room=new volume(length,breadth,height);
        System.out.println("area="+room.area());
        System.out.println("volume="+room.volume());
    }
}
